# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# MongoDB Atlas connection string. The project uses a single shared
# Atlas cluster — ask John for your username/password (one has been
# created for each team member) rather than using someone else's.
MONGODB_URI=mongodb+srv://<your-username>:<your-password>@cluster0.sw2mcu8.mongodb.net/fixflow?retryWrites=true&w=majority

# Port the Express server listens on
PORT=8001
